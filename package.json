{
  "name": "dsh-hindsight-control-plane",
  "version": "0.1.0",
  "description": "把 Hindsight 记忆控制台嵌进 DSH 主面板：侧栏一键打开整块控制台，npx 拉起、随插件起停。Embed the Hindsight memory console in the DSH main panel.",
  "license": "MIT",
  "author": "Apauto-to-all",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apauto-to-all/dsh-hindsight-control-plane.git"
  },
  "icon": "icon.svg",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}