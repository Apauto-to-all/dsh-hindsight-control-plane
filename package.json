{
  "name": "dsh-hindsight-control-plane",
  "version": "0.1.0",
  "description": "把 Hindsight 控制台嵌进 DSH 主面板，并用 npx 拉起它。",
  "license": "MIT",
  "author": "Apauto-to-all",
  "icon": "icon.svg",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}